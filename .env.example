# Backend service URL for API calls
# # Backend configuration
# VITE_BACKEND_BASE_URL=http://backend:6789

# DJI Cloud API App License (get from https://developer.dji.com/user/apps/)
# Used by backend and frontend
DJI_CLOUD_API_APP_ID=
DJI_CLOUD_API_APP_KEY=
DJI_CLOUD_API_APP_LICENSE=

# Address the backend uses to connect to the broker.
# In docker leave as the in-network service name "emqx"; on bare metal use the broker host.
DJI_MQTT_HOST=emqx
DJI_MQTT_PORT=1883

# Address advertised to clients/devices (Pilot app, web UI, docks/drones).
# Must be routable from them - set to the host machine's LAN IP (e.g. 192.168.x.x).
# If left blank it falls back to DJI_MQTT_HOST.
DJI_MQTT_PUBLIC_HOST=
DJI_MQTT_PUBLIC_PORT=1883

# DRC (Direct Remote Control) websocket broker advertised to devices.
# Set to the host machine's LAN IP. Falls back to DJI_MQTT_PUBLIC_HOST when blank.
DJI_DRC_MQTT_HOST=
DJI_DRC_MQTT_PORT=8083
